{
  "expo": {
    "name": "RideFlow",
    "slug": "rideflow",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rideflow",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ph.rideflow.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RideFlow uses your location to navigate and track your rides.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "RideFlow tracks your ride in the background so you can lock your phone while cycling.",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "ph.rideflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0F14"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow RideFlow to use your location to track rides."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "YOUR_MAPBOX_DOWNLOAD_TOKEN"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
